{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/session_start.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\session_start.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/stop_gate.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\scripts\\stop_gate.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
